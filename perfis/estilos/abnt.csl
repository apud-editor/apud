<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" demote-non-dropping-particle="never" page-range-format="expanded" default-locale="pt-BR">
  <!--
    Estilo ABNT do Apud: NBR 10520:2023 (citações) e NBR 6023:2025 (referências).

    Feito a partir do estilo "Associação Brasileira de Normas Técnicas" do
    repositório de estilos do Zotero (licença CC BY-SA 3.0), que segue a
    NBR 6023:2002. A estrutura de macros foi mantida; as regras foram
    reescritas para as edições atuais.

    COMO O PERFIL COMANDA ESTE ARQUIVO
    Uma marca <!- - apud: nome da regra - -> (sem os espaços entre os hífens)
    fica logo antes do elemento que a regra ajusta. Antes de gerar o PDF, o
    Apud troca os atributos desse elemento conforme o valor no perfil
    perfis/abnt.txt. As marcas "apud modelo" guardam o modelo que este
    arquivo monta, para a conferência comparar com o perfil.

    QUEM FAZ O QUÊ
    As chamadas no texto, como (Silva, 2019, p. 15), são montadas pelo Apud
    com as regras do perfil (src/citacoes/motor.ts), porque o Typst não
    aplica direito algumas regras da ABNT nas chamadas. Este estilo monta a
    lista de referências. O bloco <citation> abaixo existe porque o formato
    exige, e serve a quem usar este arquivo fora do Apud.

    DADOS QUE O APUD PREPARA ANTES DE CHAMAR ESTE ESTILO
    O CSL não tem campos para algumas regras da ABNT. O Apud usa estes:
    - genre: o subtítulo de livros, sites e do livro de um capítulo, para que
      só o título principal receba o destaque;
    - call-number: o ano já escrito, quando não é só o número: 2020a (mesmo
      autor e ano) ou [201-?] (data incerta);
    - title-short: o título curto da obra sem autor, como "Guia [...]";
    - number: o número eletrônico de artigos sem página (e2025001);
    - note: a chave de ordem alfabética sem acentos, porque o
      Typst ordena "Ávila" depois de "Zé".
  -->
  <info>
    <title>ABNT (Apud): NBR 10520:2023 e NBR 6023:2025</title>
    <title-short>ABNT</title-short>
    <id>https://github.com/apud-editor/apud/perfis/estilos/abnt</id>
    <link href="http://www.zotero.org/styles/associacao-brasileira-de-normas-tecnicas" rel="template"/>
    <author>
      <name>Juliana Geyna Régis</name>
    </author>
    <contributor>
      <name>Lucas Mation</name>
    </contributor>
    <contributor>
      <name>Eduardo Michelotti Bettoni</name>
    </contributor>
    <contributor>
      <name>Paulo Augusto Nascimento</name>
    </contributor>
    <contributor>
      <name>Iuri Gavronski</name>
    </contributor>
    <contributor>
      <name>José Antonio Meira da Rocha</name>
    </contributor>
    <contributor>
      <name>Mario José</name>
    </contributor>
    <contributor>
      <name>Pedro P. Palazzo</name>
    </contributor>
    <contributor>
      <name>Daniel Corrêa Lobato</name>
    </contributor>
    <contributor>
      <name>Apud</name>
    </contributor>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <summary>Estilo ABNT autor-data, conforme NBR 10520:2023 e NBR 6023:2025, ajustado pelo perfil do Apud.</summary>
    <updated>2026-11-20T12:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="pt-BR">
    <!-- apud: meses -->
    <terms>
      <term name="month-01" form="short">jan.</term>
      <term name="month-02" form="short">fev.</term>
      <term name="month-03" form="short">mar.</term>
      <term name="month-04" form="short">abr.</term>
      <term name="month-05" form="short">maio</term>
      <term name="month-06" form="short">jun.</term>
      <term name="month-07" form="short">jul.</term>
      <term name="month-08" form="short">ago.</term>
      <term name="month-09" form="short">set.</term>
      <term name="month-10" form="short">out.</term>
      <term name="month-11" form="short">nov.</term>
      <term name="month-12" form="short">dez.</term>
      <term name="editor" form="short">
        <single>org.</single>
        <multiple>org.</multiple>
      </term>
      <term name="in">In</term>
      <term name="et-al">et al.</term>
      <term name="edition" form="short">ed.</term>
      <term name="page" form="short">
        <single>p.</single>
        <multiple>p.</multiple>
      </term>
      <term name="volume" form="short">
        <single>v.</single>
        <multiple>v.</multiple>
      </term>
      <term name="issue" form="short">
        <single>n.</single>
        <multiple>n.</multiple>
      </term>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>

  <!-- ===== Autores ===== -->

  <!-- Autor na lista de referências: SOBRENOME, Prenome; SOBRENOME, Prenome. -->
  <macro name="autor">
    <names variable="author">
      <!-- apud: referências, prenomes -->
      <name name-as-sort-order="all" sort-separator=", " delimiter="; " delimiter-precedes-last="always" initialize="false" initialize-with=". ">
        <!-- apud: referências, sobrenome -->
        <name-part name="family" text-case="uppercase"/>
      </name>
      <et-al font-style="italic"/>
      <label form="short" prefix=" (" suffix=")" text-case="lowercase"/>
      <substitute>
        <names variable="editor"/>
        <!-- Obra sem autor: entra pelo título, sem destaque. O Apud já põe a
             primeira palavra em maiúsculas (GUIA de normalização). -->
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <!-- Organizadores do livro, no capítulo: SOBRENOME, Prenome (org.) -->
  <macro name="organizadores">
    <names variable="editor">
      <!-- apud: referências, prenomes -->
      <name name-as-sort-order="all" sort-separator=", " delimiter="; " delimiter-precedes-last="always" initialize="false" initialize-with=". ">
        <!-- apud: referências, sobrenome -->
        <name-part name="family" text-case="uppercase"/>
      </name>
      <et-al font-style="italic"/>
      <label form="short" prefix=" (" suffix=")" text-case="lowercase"/>
    </names>
  </macro>

  <!-- Autor na chamada: (Silva, 2019). -->
  <macro name="autor-chamada">
    <names variable="author">
      <name form="short" delimiter="; " delimiter-precedes-last="always">
        <name-part name="family"/>
      </name>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <!-- Obra sem autor: (Guia [...], 2025). O título curto vem do Apud. -->
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <!-- ===== Títulos ===== -->

  <!-- Título com destaque; o subtítulo (em genre) vem sem destaque. -->
  <macro name="titulo-destacado">
    <group delimiter=": ">
      <!-- apud: referências, destaque do título -->
      <text variable="title" font-weight="bold"/>
      <text variable="genre"/>
    </group>
  </macro>

  <!-- Título do livro, num capítulo, com o mesmo destaque. -->
  <macro name="titulo-do-livro">
    <group delimiter=": ">
      <!-- apud: referências, destaque do título -->
      <text variable="container-title" font-weight="bold"/>
      <text variable="genre"/>
    </group>
  </macro>

  <!-- Título da revista, num artigo, com o mesmo destaque. -->
  <macro name="titulo-da-revista">
    <!-- apud: referências, destaque do título -->
    <text variable="container-title" font-weight="bold"/>
  </macro>

  <!-- ===== Datas ===== -->

  <!-- Ano. Data incerta vem escrita pelo Apud: [2019?], [201-], [201-?]. -->
  <macro name="ano">
    <choose>
      <if variable="call-number">
        <text variable="call-number"/>
      </if>
      <else>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </else>
    </choose>
  </macro>

  <!-- Data completa: 2 maio 2024; mar. 2025; 2019. -->
  <macro name="data">
    <choose>
      <if variable="call-number">
        <text variable="call-number"/>
      </if>
      <else>
        <date variable="issued">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="short" suffix=" "/>
          <date-part name="year"/>
        </date>
      </else>
    </choose>
  </macro>

  <!-- Mês e ano, para artigos: mar. 2025. -->
  <macro name="mes-e-ano">
    <choose>
      <if variable="call-number">
        <text variable="call-number"/>
      </if>
      <else>
        <date variable="issued">
          <date-part name="month" form="short" suffix=" "/>
          <date-part name="year"/>
        </date>
      </else>
    </choose>
  </macro>

  <!-- ===== Partes da referência ===== -->

  <!-- 2. ed. (se a edição vier como texto, como "2. ed. rev.", sai como está). -->
  <macro name="edicao">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="numeric" suffix="."/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <!-- Cidade: Editora, com [S. l.] e [s. n.] quando faltam. -->
  <macro name="local-e-editora">
    <choose>
      <if variable="publisher-place publisher" match="all">
        <group delimiter=": ">
          <text variable="publisher-place"/>
          <text variable="publisher"/>
        </group>
      </if>
      <else-if variable="publisher">
        <group delimiter=": ">
          <!-- apud: referências, sem local -->
          <text value="[S. l.]" font-style="italic"/>
          <text variable="publisher"/>
        </group>
      </else-if>
      <else-if variable="publisher-place">
        <group delimiter=": ">
          <text variable="publisher-place"/>
          <!-- apud: referências, sem editora -->
          <text value="[s. n.]" font-style="italic"/>
        </group>
      </else-if>
      <else>
        <!-- apud: referências, sem local e editora -->
        <text value="[S. l.: s. n.]" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <!-- Cidade: Editora, ano. -->
  <macro name="publicacao">
    <group delimiter=", ">
      <text macro="local-e-editora"/>
      <text macro="ano"/>
    </group>
  </macro>

  <!-- Cidade: Editora, data completa (sites). -->
  <macro name="publicacao-com-data">
    <group delimiter=", ">
      <text macro="local-e-editora"/>
      <text macro="data"/>
    </group>
  </macro>

  <!-- Só o local: Maceió, ou [S. l.] quando falta (redes sociais). -->
  <macro name="local">
    <choose>
      <if variable="publisher-place">
        <text variable="publisher-place"/>
      </if>
      <else>
        <!-- apud: referências, sem local -->
        <text value="[S. l.]" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <!-- Série com número: (Nota Técnica, n. 103). O Apud põe o nome da série em archive. -->
  <macro name="serie">
    <group delimiter=", " prefix="(" suffix=")">
      <text variable="archive"/>
      <group delimiter=" ">
        <text term="issue" form="short"/>
        <text variable="number"/>
      </group>
    </group>
  </macro>

  <!-- Tese: 312 f. Tese (Doutorado em Psicologia) – Universidade, Cidade, ano. -->
  <macro name="nota-de-tese">
    <group delimiter=". ">
      <text variable="number-of-pages" suffix=" f"/>
      <group delimiter=" – ">
        <text variable="archive"/>
        <group delimiter=", ">
          <text variable="publisher"/>
          <text variable="publisher-place"/>
          <text macro="ano"/>
        </group>
      </group>
    </group>
  </macro>

  <!-- p. 9-30 -->
  <macro name="paginas">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>

  <!-- v. 10, n. 2, p. 1-15 ou, sem página, v. 10, e2025001 -->
  <macro name="volume-numero-paginas">
    <group delimiter=", ">
      <group delimiter=" ">
        <label variable="volume" form="short"/>
        <text variable="volume"/>
      </group>
      <group delimiter=" ">
        <label variable="issue" form="short"/>
        <text variable="issue"/>
      </group>
      <choose>
        <if variable="number">
          <text variable="number"/>
        </if>
        <else>
          <text macro="paginas"/>
        </else>
      </choose>
    </group>
  </macro>

  <macro name="doi">
    <text variable="DOI" prefix="DOI: "/>
  </macro>

  <!-- Disponível em: https://... Acesso em: 15 maio 2025 -->
  <macro name="acesso">
    <group delimiter=". ">
      <group delimiter=" ">
        <!-- apud: referências, rótulo do endereço -->
        <text value="Disponível em:"/>
        <text variable="URL"/>
      </group>
      <group delimiter=" ">
        <!-- apud: referências, rótulo do acesso -->
        <text value="Acesso em:"/>
        <date variable="accessed">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="short" suffix=" "/>
          <date-part name="year"/>
        </date>
      </group>
    </group>
  </macro>

  <!-- ===== Citação ===== -->
  <!-- (Silva, 2019, p. 15). No Apud, as chamadas são montadas fora daqui. -->
  <citation>
    <sort>
      <key macro="autor-chamada"/>
      <key macro="ano"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="autor-chamada"/>
        <text macro="ano"/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>

  <!-- ===== Referências ===== -->
  <!-- apud: autores, quatro ou mais -->
  <bibliography>
    <sort>
      <key variable="note"/>
      <key macro="autor"/>
      <key macro="ano"/>
    </sort>
    <layout>
      <choose>
        <!-- apud modelo: modelo, trabalho em evento = SOBRENOME, Prenome. Título do trabalho. *In*: NOME DO EVENTO, 20., 2024, Cidade. **Anais** [...]. Cidade: Editora, ano. p. 15-30. -->
        <!-- O Apud escreve o evento (em archive) e corta o título dos anais na designação; o [...] vem em archive-location. -->
        <if type="paper-conference">
          <group delimiter=". " suffix=".">
            <text macro="autor"/>
            <text variable="title"/>
            <group delimiter=": ">
              <text term="in" font-style="italic"/>
              <group delimiter=". ">
                <text variable="archive"/>
                <group delimiter=" ">
                  <text macro="titulo-da-revista"/>
                  <text variable="archive_location"/>
                </group>
              </group>
            </group>
            <text macro="publicacao"/>
            <text macro="paginas"/>
            <text macro="doi"/>
            <text macro="acesso"/>
          </group>
        </if>
        <!-- apud modelo: modelo, capítulo = SOBRENOME, Prenome. Título do capítulo. *In*: SOBRENOME, Prenome (org.). **Título do livro**. Cidade: Editora, ano. p. 9-30. -->
        <else-if type="chapter entry-encyclopedia entry-dictionary" match="any">
          <group delimiter=". " suffix=".">
            <text macro="autor"/>
            <text variable="title"/>
            <group delimiter=": ">
              <text term="in" font-style="italic"/>
              <group delimiter=". ">
                <text macro="organizadores"/>
                <text macro="titulo-do-livro"/>
              </group>
            </group>
            <text macro="edicao"/>
            <text macro="publicacao"/>
            <text macro="paginas"/>
            <text macro="doi"/>
            <text macro="acesso"/>
          </group>
        </else-if>
        <!-- apud modelo: modelo, notícia = TÍTULO da notícia. **Nome do Jornal**, Cidade, 3 jul. 2024. Disponível em: https://exemplo.org. Acesso em: 3 jul. 2024. -->
        <else-if type="article-newspaper">
          <group delimiter=". " suffix=".">
            <text macro="autor"/>
            <text variable="title"/>
            <group delimiter=", ">
              <text macro="titulo-da-revista"/>
              <text variable="publisher-place"/>
              <text macro="volume-numero-paginas"/>
              <text macro="data"/>
            </group>
            <text macro="doi"/>
            <text macro="acesso"/>
          </group>
        </else-if>
        <!-- apud modelo: modelo, artigo = SOBRENOME, Prenome. Título do artigo. **Título da Revista**, cidade, v. 10, n. 2, p. 1-15, mar. 2025. DOI: 10.0000/xxxx. -->
        <else-if type="article-journal article-magazine" match="any">
          <group delimiter=". " suffix=".">
            <text macro="autor"/>
            <text variable="title"/>
            <group delimiter=", ">
              <text macro="titulo-da-revista"/>
              <text variable="publisher-place"/>
              <text macro="volume-numero-paginas"/>
              <text macro="mes-e-ano"/>
            </group>
            <text macro="doi"/>
            <text macro="acesso"/>
          </group>
        </else-if>
        <!-- apud modelo: modelo, rede social = SOBRENOME, Prenome. **Texto da postagem**. Cidade, 16 fev. 2025. Instagram: @perfil. Disponível em: https://exemplo.org. Acesso em: 20 maio 2026. -->
        <else-if type="post">
          <group delimiter=". " suffix=".">
            <text macro="autor"/>
            <text macro="titulo-destacado"/>
            <group delimiter=", ">
              <text macro="local"/>
              <text macro="data"/>
            </group>
            <group delimiter=": ">
              <text variable="container-title"/>
              <text variable="archive_location"/>
            </group>
            <text macro="acesso"/>
          </group>
        </else-if>
        <!-- Sites e documentos online: AUTOR. **Título**. Cidade: Editora, 2 maio 2024. Disponível em: ... Acesso em: ... -->
        <else-if type="webpage post-weblog" match="any">
          <group delimiter=". " suffix=".">
            <text macro="autor"/>
            <text macro="titulo-destacado"/>
            <text macro="publicacao-com-data"/>
            <text macro="doi"/>
            <text macro="acesso"/>
          </group>
        </else-if>
        <!-- Leis: BRASIL. Lei nº 10.216, de 6 de abril de 2001. Ementa. Cidade: Editora, ano. Disponível em: ... -->
        <else-if type="bill legislation" match="any">
          <group delimiter=". " suffix=".">
            <text macro="autor"/>
            <text variable="title"/>
            <text variable="abstract"/>
            <text macro="publicacao"/>
            <text macro="acesso"/>
          </group>
        </else-if>
        <!-- apud modelo: modelo, tese = SOBRENOME, Prenome. **Título**: subtítulo. 2017. 312 f. Tese (Doutorado em Área) – Universidade, Cidade, 2017. -->
        <else-if type="thesis">
          <group delimiter=". " suffix=".">
            <text macro="autor"/>
            <text macro="titulo-destacado"/>
            <text macro="ano"/>
            <text macro="nota-de-tese"/>
            <text macro="doi"/>
            <text macro="acesso"/>
          </group>
        </else-if>
        <!-- apud modelo: modelo, relatório = SOBRENOME, Prenome. **Título**. Cidade: Editora, ano. (Nota Técnica, n. 103). -->
        <else-if type="report">
          <group delimiter=". " suffix=".">
            <text macro="autor"/>
            <text macro="titulo-destacado"/>
            <text macro="edicao"/>
            <text macro="publicacao"/>
            <text macro="serie"/>
            <text macro="doi"/>
            <text macro="acesso"/>
          </group>
        </else-if>
        <!-- apud modelo: modelo, livro = SOBRENOME, Prenome. **Título**: subtítulo. 2. ed. Cidade: Editora, ano. -->
        <else>
          <group delimiter=". " suffix=".">
            <text macro="autor"/>
            <text macro="titulo-destacado"/>
            <text macro="edicao"/>
            <text macro="publicacao"/>
            <text macro="doi"/>
            <text macro="acesso"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
