        "titulo": "Me chamam rua, população, uma situação",
        "subtitulo": "os nomes da rua e as políticas da cidade",
        "publicacao": {
          "titulo": "Psicologia & Sociedade",
          "volume": "32"
        },
        "numeroEletronico": "e223876",
